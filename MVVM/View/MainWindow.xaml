<Window
    x:Class="Wpf_App_Navigation_Tutorial.MVVM.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf_App_Navigation_Tutorial.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Wpf_App_Navigation_Tutorial.MVVM.ViewModel"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0">
            <Label
                Height="25"
                Margin="10"
                Content="{Binding Title}" />
            <Button
                Height="25"
                Margin="10"
                Command="{Binding NavigateToHomeCommand}"
                Content="Home" />

            <Button
                Height="25"
                Margin="10"
                Command="{Binding NavigateToSettingsCommand}"
                Content="Settings" />
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding NavigationService.CurrentView}" />
    </Grid>
</Window>
