<Window
    x:Class="Wpf_App_Navigation_Tutorial.MVVM.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf_App_Navigation_Tutorial.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Wpf_App_Navigation_Tutorial.MVVM.ViewModel"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <!--  Set a fixed or proportional width  -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#EEE">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <!--  Spacer if needed  -->
            </Grid.RowDefinitions>

            <Label
                Margin="10"
                HorizontalAlignment="Left"
                Content="{Binding Title}" />

            <Button
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                Command="{Binding NavigateToHomeCommand}"
                Content="Home" />

            <Button
                Grid.Row="2"
                Margin="10"
                HorizontalAlignment="Stretch"
                Command="{Binding NavigateToSettingsCommand}"
                Content="Settings" />
        </Grid>

        <Border Grid.Column="1" Margin="10">
            <ContentControl
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{Binding NavigationService.CurrentView}" />
        </Border>
    </Grid>
</Window>
